  "files": ["bridge.mjs", "scenarios.mjs", "pi.mjs", "dsh.mjs", "cordis.patch.yml", "verify-host-exit.py", "doctor.mjs", "install.py", "trial.mjs", "skills", "assets", "README.md", "README.zh-CN.md", "LICENSE", "NOTICE"],
  "scripts": {"prepack": "node pack.mjs", "pretest": "node pack.mjs", "test": "node --test test/*.test.mjs"}
}
