{
  "name": "@openguardrail/cleanup-preview",
  "version": "0.1.0-alpha.0",
  "description": "Evidence-driven cleanup tools for pi and DeepSeek Harness, using an isolated OpenGuardrail service",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": ["pi-package", "dsh-plugin", "openguardrail"],
  "engines": {"node": ">=22", "dsh": "0.2.2-rc.1"},
  "exports": {"./pi": "./pi.mjs", "./dsh": "./dsh.mjs"},
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}},
  "pi": {"extensions": ["./pi.mjs"], "skills": ["./skills"]},
  "files": ["bridge.mjs", "pi.mjs", "dsh.mjs", "cordis.patch.yml", "worker.py", "verify-host-exit.py", "skills", "assets", "README.md", "README.zh-CN.md", "LICENSE", "NOTICE"],
  "scripts": {"prepack": "node pack.mjs", "test": "node --test test/*.test.mjs"}
}
