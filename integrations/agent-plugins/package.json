{
  "name": "@openguardrail/agent-plugins-preview",
  "version": "0.1.0-alpha.1",
  "description": "OpenGuardrail scenario adapters for pi and DeepSeek Harness",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": ["pi-package", "dsh-plugin", "openguardrail"],
  "engines": {"node": ">=22", "pi": "1.5.0", "dsh": "0.2.2-rc.1"},
  "exports": {"./pi": "./pi.mjs", "./dsh": "./dsh.mjs"},
  "dsh": {"bundle": {"patch": "./cordis.patch.yml"}},
